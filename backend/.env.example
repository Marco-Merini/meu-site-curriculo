# Porta do servidor HTTP Spring Boot
PORT=8080

# Origens permitidas no CORS (separadas por vírgula, sem curinga *)
PORTFOLIO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuração opcional para serviço externo de envio de e-mail (Webhook HTTP/API)
PORTFOLIO_MAIL_ENABLED=false
PORTFOLIO_MAIL_WEBHOOK_URL=
PORTFOLIO_MAIL_API_TOKEN=
PORTFOLIO_MAIL_FROM=
